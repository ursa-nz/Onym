-     ./configure --with-tclconfig=/usr/lib/tcl8.4 --with-tkconfig=/usr/lib/tk8.4 "$@"
+     ./configure --with-tclconfig=/usr/lib/tcl8.6 --with-tkconfig=/usr/lib/tk8.6 "$@"
 
      echo 
      echo "Now type 'make' to compile $PROG."
