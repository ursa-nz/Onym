<schemalist>
  <enum id="nz.ursa.Onym.TreeExpansion">
    <value nick="collapsed" value="0"/>
    <value nick="chains" value="1"/>
    <value nick="all" value="2"/>
  </enum>
  <schema id="nz.ursa.Onym" path="/nz/ursa/Onym/">
    <key name="window-width" type="i">
      <default>480</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>620</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximised</summary>
    </key>
    <key name="recent-words" type="as">
      <default>[]</default>
      <summary>Recently looked up words, most recent first</summary>
    </key>
    <key name="tree-expansion" enum="nz.ursa.Onym.TreeExpansion">
      <default>"chains"</default>
      <summary>How relation trees expand by default</summary>
    </key>
  </schema>
</schemalist>
