# The application icon, named by the app id so GTK and the shell resolve it. A scalable colour icon
# and a monochrome symbolic variant, installed into the hicolor theme.
icons_dir = get_option('datadir') / 'icons' / 'hicolor'

install_data('hicolor/scalable/apps/nz.ursa.Onym.svg',
  install_dir: icons_dir / 'scalable' / 'apps',
)
install_data('hicolor/symbolic/apps/nz.ursa.Onym-symbolic.svg',
  install_dir: icons_dir / 'symbolic' / 'apps',
)
