<component type="desktop-application">
  <id>nz.ursa.Onym</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Onym</name>
  <summary>Thesaurus of synonyms, antonyms, and word relations</summary>

  <description>
    <p>Onym is a thesaurus for GNOME. Look a word up and Onym shows its synonyms and antonyms, then the lexical relations that connect it to other words: what it is a kind of, its kinds, and the wholes and parts it belongs to, each shown as a tree you can open.</p>
    <p>The synonyms, antonyms and the terms in the relation trees are clickable, so one lookup leads to the next with a click. Each entry also carries its meanings, grouped by part of speech and shown with example sentences, so the senses stay in view while you explore. Search is live, with completion as you type and a suggestion when a word is misspelt.</p>
    <p>Where a word's origin is known, Onym shows its etymology, drawn from Wiktionary. Where a sense has translations, Onym lists the words other languages use for it, grouped by language.</p>
    <p>The word data comes from Open English WordNet 2025, under the CC-BY-4.0 licence, with the Princeton WordNet grant preserved. Etymology comes from Wiktionary, under the CC-BY-SA-3.0 licence. Translations come from the Open Multilingual Wordnet: MultiWordNet for Italian under CC-BY-3.0, Wordnet Bahasa for Indonesian under the MIT licence, and OpenWN-PT for Portuguese under CC-BY-SA-3.0, aligned through the Collaborative Interlingual Index under CC-BY-4.0. The query engine is derived from Artha, an earlier WordNet thesaurus by Sundaram Ramaswamy.</p>
  </description>

  <launchable type="desktop-id">nz.ursa.Onym.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://forge.ursa.nz/ursa-nz/Onym/raw/branch/main/data/screenshots/onym-result.png</image>
      <caption>A word with its meanings, synonyms, and the relations that connect it</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://forge.ursa.nz/ursa-nz/Onym/raw/branch/main/data/screenshots/onym-relations.png</image>
      <caption>Lexical relations shown as expandable trees</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://forge.ursa.nz/ursa-nz/Onym/raw/branch/main/data/screenshots/onym-about.png</image>
      <caption>About Onym</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://ursa.nz</url>
  <url type="bugtracker">https://forge.ursa.nz/ursa-nz/Onym/issues</url>
  <url type="vcs-browser">https://forge.ursa.nz/ursa-nz/Onym</url>

  <developer id="nz.ursa">
    <name>ursa.nz</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.6.0" date="2026-06-22">
      <description>
        <p>Translations.</p>
        <ul>
          <li>Entries now show translations: where a sense has them, the words other languages use for it, grouped by language.</li>
          <li>Translations come from the Open Multilingual Wordnet, with MultiWordNet for Italian, Wordnet Bahasa for Indonesian, and OpenWN-PT for Portuguese, each credited under its own licence.</li>
          <li>The word data is now Open English WordNet 2025, a larger and more current base than before.</li>
          <li>The About dialog credits the translation sources and Open English WordNet.</li>
          <li>Navigating between words no longer leaves the first definition highlighted.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-06-20">
      <description>
        <p>Word origins.</p>
        <ul>
          <li>Entries now show an etymology, where one is known, drawn from Wiktionary under the CC-BY-SA-3.0 licence.</li>
          <li>Definition and etymology text can be selected and copied.</li>
          <li>The About dialog credits Wiktionary and the wiktextract dataset.</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-06-12">
      <description>
        <p>A refinement of the new sidebar.</p>
        <ul>
          <li>The sidebar stays on screen whenever the window is wide, listing extended words and completions under subheadings.</li>
          <li>Browsing within a word family keeps the list in place, with the current word marked.</li>
          <li>First runs open wide enough for the sidebar when the screen has room.</li>
          <li>The About dialog acknowledges Narrm alongside Kaurna Pangkarra, and links Artha's home and the engine repository.</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-06-12">
      <description>
        <p>Desktop features, bringing the desktop closer to the mobile app's feel.</p>
        <ul>
          <li>A sidebar on wide windows lists the words that extend the current one, such as family Cathartidae for family.</li>
          <li>A random word action: the dice button in the sidebar, or Ctrl+R.</li>
          <li>Right-click, or the Menu key, copies a word title or chip as plain text.</li>
          <li>The About dialog credits onym-engine, the shared lookup core.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-06-11">
      <description>
        <p>The lookup engine is new.</p>
        <ul>
          <li>Lookups run on onym-engine, a shared Rust core replacing the bundled WordNet C library.</li>
          <li>Variant spellings no longer hide a word's other senses.</li>
          <li>Relation trees no longer pick up another branch's children.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-06-08">
      <description>
        <p>A maintenance release.</p>
        <ul>
          <li>The app icon scales correctly at small sizes.</li>
          <li>Screenshots and the description show correctly in software centres.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-06-05">
      <description>
        <p>First packaged release.</p>
      </description>
    </release>
  </releases>
</component>
